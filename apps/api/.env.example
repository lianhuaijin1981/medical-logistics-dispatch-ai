# ============================================================
# 医药物流智能调度系统 — 后端环境变量模板
# 复制此文件为 .env.local 并填写实际值
# ============================================================

# --- 应用配置 ---
NODE_ENV=production
PORT=4000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/med-logistics
# 生产环境推荐使用 MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/med-logistics?retryWrites=true&w=majority

# --- Redis ---
REDIS_URL=redis://localhost:6379
# 生产环境示例:
# REDIS_URL=redis://:password@host:6379

# --- JWT ---
JWT_SECRET=your-strong-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:3000
# 生产环境设为前端域名:
# CORS_ORIGIN=https://your-frontend-domain.com

# --- AI 代理 (可选) ---
# OPENAI_API_KEY=sk-...
# AI_PROXY_URL=https://api.openai.com
